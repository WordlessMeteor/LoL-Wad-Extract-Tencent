{
    "name": "rcp-fe-lol-typekit",
    "pluginDependencies": [
        "rcp-fe-common-libs"
    ],
    "riotMeta": {
        "type": "frontend",
        "subtype": "ui",
        "app": "lol",
        "feature": "Shared",
        "hasBundledAssets": true,
        "createPerLocaleWads": true,
        "globalAssetBundles": [
            "default-assets.wad"
        ],
        "perLocaleAssetBundles": {
            "ar_AE": [
                "ar_AE-assets.wad"
            ],
            "ja_JP": [
                "ja_JP-assets.wad"
            ],
            "ko_KR": [
                "ko_KR-assets.wad"
            ],
            "th_TH": [
                "th_TH-assets.wad"
            ],
            "zh_CN": [
                "zh_CN-assets.wad"
            ],
            "zh_MY": [
                "zh_MY-assets.wad"
            ],
            "zh_TW": [
                "zh_TW-assets.wad"
            ]
        }
    }
}